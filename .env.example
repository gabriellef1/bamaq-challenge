# =============================================================================
# BAMAQ Challenge - variáveis de ambiente
# -----------------------------------------------------------------------------
# Copie para .env (`cp .env.example .env`) e ajuste. O .env NÃO é versionado.
# Nenhum secret vive no código: tudo é lido daqui via pydantic-settings.
# =============================================================================

# ---- Aplicação -------------------------------------------------------------
APP_NAME=bamaq-requests
APP_ENV=local                  # local | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# ---- MySQL -----------------------------------------------------------------
# Em produção estes valores viriam de um secret manager (Vault/AWS SM), não de .env
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=bamaq
MYSQL_USER=bamaq
MYSQL_PASSWORD=change-me-in-production
MYSQL_ROOT_PASSWORD=change-me-root-in-production
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

# ---- Kafka -----------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_TOPIC_REQUESTS=request-processing
KAFKA_TOPIC_DLQ=request-processing-dlq
KAFKA_CONSUMER_GROUP=request-processor
KAFKA_MAX_RETRIES=3            # tentativas antes de mandar para a DLQ
KAFKA_RETRY_BASE_DELAY_SECONDS=0.5   # backoff exponencial: 0.5s, 1s, 2s...
KAFKA_RETRY_MAX_DELAY_SECONDS=10

# ---- Redis -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300          # 5 minutos: rede de segurança, não o mecanismo principal
CACHE_KEY_PREFIX=request

# ---- Segurança / API -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_CREATE=10/minute    # slowapi: limite do POST /requests
RATE_LIMIT_READ=60/minute      # slowapi: limite do GET /requests/{id}
